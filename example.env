BOT_TOKEN=
# Local compose: postgresql+asyncpg://fitness:fitness@postgres:5432/fitness
# Timeweb Apps (Cupidon postgres-dev, DB aifitness):
#   postgresql+asyncpg://aifitness:<PASSWORD>@46.229.215.63:5432/aifitness
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Timeweb Cloud AI Agent API key (JWT Bearer). Not the access-id UUID.
# Fitness Bot agent in project AI Fitness Bot (GPT 5.4 Nano).
# Access id: f1a62fb1-8a3e-4ed3-8bbe-bcce52d8c779
TIMEWEB_API_KEY=
# OpenAI-compatible agent root ONLY (no /chat/completions). Pattern:
#   https://agent.timeweb.cloud/api/v1/cloud-ai/agents/<access-id>/v1
# Wrong: .../v1/chat/completions  or  AI Gateway https://api.timeweb.ai/v1 (different product)
TIMEWEB_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/<access-id>/v1
YOUTUBE_API_KEY=
# Local compose: http://minio:9000 + bucket fitness
# Timeweb Apps: https://s3.twcstorage.ru + private bucket in project AI Fitness Bot
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1
# Offline ASR via sherpa-onnx. Leave empty to keep StubSpeechToText (voice asks for text).
# Local: make download-stt-model → ./models/sherpa-onnx-zipformer-ru-2024-09-18
# Timeweb Apps root Dockerfile downloads the pack into /app/models at build time.
SHERPA_MODEL_DIR=/app/models/sherpa-onnx-zipformer-ru-2024-09-18
SHERPA_ENCODER=encoder.int8.onnx
SHERPA_DECODER=decoder.int8.onnx
SHERPA_JOINER=joiner.int8.onnx
SHERPA_TOKENS=tokens.txt
SHERPA_NUM_THREADS=2
SHERPA_SAMPLE_RATE=16000
# Optional one-shot seed of first moderators (numeric telegram ids), not the runtime ACL.
# Comma-separated Telegram user ids (not @usernames). Applied on /start via SyncUserIdentity.
# Example operator: @vadikko2 → look up numeric id and set e.g. BOOTSTRAP_MODERATOR_TELEGRAM_IDS=123456789
BOOTSTRAP_MODERATOR_TELEGRAM_IDS=
