BOT_TOKEN=
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Timeweb Cloud AI Agent API key (JWT Bearer). Not the access-id UUID.
TIMEWEB_API_KEY=
# OpenAI-compatible agent root ONLY (no /chat/completions). Pattern:
#   https://agent.timeweb.cloud/api/v1/cloud-ai/agents/<access-id>/v1
# Wrong: .../v1/chat/completions  or  AI Gateway https://api.timeweb.ai/v1 (different product)
TIMEWEB_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/<access-id>/v1
YOUTUBE_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Offline ASR via sherpa-onnx. Leave empty to keep StubSpeechToText (voice asks for text).
# Download pack into ./models (gitignored):
#   make download-stt-model
# Then set (filenames match defaults below):
#   SHERPA_MODEL_DIR=./models/sherpa-onnx-zipformer-ru-2024-09-18
# Smaller int8-2025 pack may use decoder.onnx — set SHERPA_DECODER=decoder.onnx if needed.
# Requires ffmpeg on PATH (docker/dev image installs it). Model binaries are gitignored.
SHERPA_MODEL_DIR=./models/sherpa-onnx-zipformer-ru-2024-09-18
SHERPA_ENCODER=encoder.int8.onnx
SHERPA_DECODER=decoder.int8.onnx
SHERPA_JOINER=joiner.int8.onnx
SHERPA_TOKENS=tokens.txt
SHERPA_NUM_THREADS=2
SHERPA_SAMPLE_RATE=16000
# Optional one-shot seed of first moderators (numeric telegram ids), not the runtime ACL
BOOTSTRAP_MODERATOR_TELEGRAM_IDS=
